{
	// MCP servers for the agent framework — Cline edition.
	// Each server runs in a Docker container on the host (stdio transport).
	//
	// ── HOW THIS FILE WORKS ────────────────────────────────────────────────────
	// This is a TEMPLATE file (.cline/mcp.example.json).
	// The real .cline/mcp.json is git-ignored and generated from this template
	// by bootstrap.sh, which substitutes the placeholders below with actual host
	// values:
	//
	//   <HOST_USER>   →  $(id -un)           e.g. alice
	//   <HOST_UID>    →  $(id -u)            e.g. 1000
	//   <HOST_GID>    →  $(id -g)            e.g. 1000
	//   <HOST_HOME>   →  $HOME               e.g. /home/alice
	//   <WORKSPACE>   →  repo root dir       e.g. /home/alice/prj/agent
	//
	// To regenerate .cline/mcp.json manually:
	//   bash .github/skills/setup-mcp-server/scripts/bootstrap.sh --dry-run
	// Or, to fully bootstrap (clone + build + generate configs):
	//   bash .github/skills/setup-mcp-server/scripts/bootstrap.sh
	// ──────────────────────────────────────────────────────────────────────────
	//
	// This file is the Cline equivalent of .vscode/mcp.example.json.
	// Add new servers using the setup-mcp-server skill.
	//
	// Entry template:
	// "<server-key>": {
	//   "command": "docker",
	//   "args": ["run", "--rm", "-i", "mcp-<repo-name>"],
	//   "disabled": false,
	//   "alwaysAllow": []
	// }
	"mcpServers": {
		// Git MCP server — provides git_status, git_diff, git_log, git_commit, etc.
		// repo_path is passed per-tool call; /home is bind-mounted so host paths resolve inside the container.
		// Source: https://github.com/modelcontextprotocol/servers/tree/main/src/git
		"git": {
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"-i",
				// Run as host user to avoid permission issues with bind mounts
				"--user",
				"<HOST_UID>:<HOST_GID>",
				// Set HOME so Python and git use the right config directory
				"-e",
				"HOME=<HOST_HOME>",
				// Mount the full /home tree so any repo path on the host is reachable
				"--mount",
				"type=bind,src=/home,dst=/home",
				// Mount host ~/.gitconfig so the container inherits identity & settings
				"--mount",
				"type=bind,src=<HOST_HOME>/.gitconfig,dst=<HOST_HOME>/.gitconfig,readonly",
				// Allow git to operate on any directory regardless of UID mismatch
				"-e",
				"GIT_CONFIG_COUNT=1",
				"-e",
				"GIT_CONFIG_KEY_0=safe.directory",
				"-e",
				"GIT_CONFIG_VALUE_0=*",
				"mcp-servers-git:latest"
			],
			"disabled": false,
			"alwaysAllow": []
		},

		// Sequential Thinking MCP server — structured, reflective problem-solving via a chain-of-thought tool.
		// No bind mounts or env vars required — runs fully self-contained.
		// Source: https://github.com/modelcontextprotocol/servers/tree/main/src/sequentialthinking
		"sequentialthinking": {
			"command": "docker",
			"args": ["run", "--rm", "-i", "mcp-servers-sequentialthinking:latest"],
			"disabled": false,
			"alwaysAllow": []
		},

		// Memory MCP server — persistent knowledge graph across sessions.
		// Stores data in <HOST_HOME>/.mcp-memory/memory.jsonl (bind-mounted into the container).
		// Run as the host user so the file is owned correctly on the host filesystem.
		// Source: https://github.com/modelcontextprotocol/servers/tree/main/src/memory
		"memory": {
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"-i",
				// Run as host user so the memory file is owned by the host user
				"--user",
				"<HOST_UID>:<HOST_GID>",
				// Set MEMORY_FILE_PATH to a persistent, writable location
				"-e",
				"MEMORY_FILE_PATH=/memory/memory.jsonl",
				// Bind-mount ~/.mcp-memory on the host to /memory in the container
				"--mount",
				"type=bind,src=<HOST_HOME>/.mcp-memory,dst=/memory",
				"mcp-servers-memory:latest"
			],
			"disabled": false,
			"alwaysAllow": []
		},

		// Playwright MCP server — browser automation via accessibility snapshots.
		// stdio transport, runs headless Chromium inside the container.
		// No API key required. Use --network host if the agent needs to reach local services.
		// Source: https://github.com/microsoft/playwright-mcp
		"browser": {
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"-i",
				"--user",
				"<HOST_UID>:<HOST_GID>",
				"-e",
				"HOME=<HOST_HOME>",
				"mcp-playwright-mcp:latest"
			],
			"disabled": false,
			"alwaysAllow": []
		}
	}
}
